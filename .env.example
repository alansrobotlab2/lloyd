# Lloyd secrets and environment. Copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. app/config.py loads it into os.environ at boot, then
# expands ${VAR} placeholders throughout config.yaml — so secrets live here,
# never as literals in the tracked config.yaml.

# ── Local vLLM endpoint (Claude Code / Anthropic-compatible clients) ──
# No real credential: the local server does not authenticate.
# The two CUSTOM_MODEL_OPTION values are display labels only — keep them in sync
# with models.primary.env in config.yaml, and with agent-llm-primary.conf's
# --served-model-name, or the model picker shows a name that no longer exists.
ANTHROPIC_BASE_URL=http://127.0.0.1:8096
ANTHROPIC_API_KEY=no-key-required
ANTHROPIC_CUSTOM_MODEL_OPTION=primary
ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=Primary

# ── LiveKit (voice/RTC) ──
# Generate with: bash scripts/gen-livekit-secrets.sh
# Consumed by app/config.py (via ${VAR} in config.yaml), livekit_worker.py,
# and agent-services/bin/start-livekit-server.sh (via envsubst).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Discord bot (optional) ──
# Leave unset to keep the Discord tools disabled.
# DISCORD_TOKEN=
