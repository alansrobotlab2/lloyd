{
  "manifest_version": 3,
  "name": "Lloyd Side Panel",
  "version": "1.0.0",
  "description": "One Lloyd session per browser tab — press \"Check it out, Lloyd\" to have Lloyd pull the page (or YouTube transcript) and return the highlights in the side panel.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lloyd",
    "default_icons": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ]
}
