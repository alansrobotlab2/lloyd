  %42 = getelementptr i32, ptr addrspace(1) %0, i64 %.pre-phi9, !dbg !19
  %43 = sext i32 %19 to i64, !dbg !33
  %44 = getelementptr i32, ptr addrspace(1) %42, i64 %43, !dbg !33
  %45 = icmp eq i32 %.pre-phi13, 0, !dbg !20
  tail call void asm sideeffect "@$2 st.global.b32 [ $1 + 0 ], { $0 };", "r,l,b"(i32 %41, ptr addrspace(1) %44, i1 %45) #2, !dbg !20
  br label %._crit_edge.thread, !dbg !30

._crit_edge.thread:                               ; preds = %.thread, %._crit_edge, %.critedge
  ret void, !dbg !34
