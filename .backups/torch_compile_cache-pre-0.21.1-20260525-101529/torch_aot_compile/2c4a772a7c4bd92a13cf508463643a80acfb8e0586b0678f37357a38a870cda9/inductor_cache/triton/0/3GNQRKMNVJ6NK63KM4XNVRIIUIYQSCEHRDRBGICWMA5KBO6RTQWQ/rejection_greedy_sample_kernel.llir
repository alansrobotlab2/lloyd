.lr.ph:                                           ; preds = %._crit_edge3
  %21 = sext i32 %16 to i64
  %22 = getelementptr i32, ptr addrspace(1) %2, i64 %21
  %23 = getelementptr i64, ptr addrspace(1) %3, i64 %21
  %24 = add i32 %5, 1
  %25 = mul i32 %24, %9
  %26 = sext i32 %25 to i64
  %27 = getelementptr i32, ptr addrspace(1) %0, i64 %26
  %28 = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %29 = and i32 %28, 127
  %30 = icmp eq i32 %29, 0
  %wide.trip.count = zext nneg i32 %19 to i64, !dbg !16
  br label %.backedge, !dbg !16

.backedge:                                        ; preds = %.backedge.backedge, %.lr.ph
  %indvars.iv = phi i64 [ 0, %.lr.ph ], [ %indvars.iv.be, %.backedge.backedge ]
  %31 = phi i1 [ false, %.lr.ph ], [ %.be, %.backedge.backedge ]
  br i1 %31, label %.thread, label %32, !dbg !21

32:                                               ; preds = %.backedge
  %33 = getelementptr i32, ptr addrspace(1) %22, i64 %indvars.iv, !dbg !22
  %34 = tail call i32 asm sideeffect "mov.u32 $0, 0x0;\0A\09ld.global.b32 { $0 }, [ $1 + 0 ];", "=r,l"(ptr addrspace(1) %33) #2, !dbg !23
  %35 = getelementptr i64, ptr addrspace(1) %23, i64 %indvars.iv, !dbg !24
  %36 = tail call i64 asm sideeffect "mov.u64 $0, 0x0;\0A\09ld.global.b64 { $0 }, [ $1 + 0 ];", "=l,l"(ptr addrspace(1) %35) #2, !dbg !25
  %37 = trunc i64 %36 to i32, !dbg !26
  %38 = icmp ne i32 %34, %37, !dbg !27
  %39 = getelementptr i32, ptr addrspace(1) %27, i64 %indvars.iv, !dbg !28
  tail call void asm sideeffect "@$2 st.global.b32 [ $1 + 0 ], { $0 };", "r,l,b"(i32 %37, ptr addrspace(1) %39, i1 %30) #2, !dbg !29
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1, !dbg !16
  %exitcond.not = icmp eq i64 %indvars.iv.next, %wide.trip.count, !dbg !16
  br i1 %exitcond.not, label %._crit_edge, label %.backedge.backedge, !dbg !16

.backedge.backedge:                               ; preds = %32, %.thread
  %indvars.iv.be = phi i64 [ %indvars.iv.next, %32 ], [ %indvars.iv.next15, %.thread ]
  %.be = phi i1 [ %38, %32 ], [ true, %.thread ]
  br label %.backedge, !dbg !21

.thread:                                          ; preds = %.backedge
  %indvars.iv.next15 = add nuw nsw i64 %indvars.iv, 1, !dbg !16
  %exitcond.not16 = icmp eq i64 %indvars.iv.next15, %wide.trip.count, !dbg !16
  br i1 %exitcond.not16, label %._crit_edge.thread, label %.backedge.backedge, !dbg !16

._crit_edge:                                      ; preds = %32
  br i1 %38, label %._crit_edge.thread, label %.critedge, !dbg !30

.critedge:                                        ; preds = %..critedge_crit_edge, %._crit_edge
  %.pre-phi13 = phi i32 [ %.pre12, %..critedge_crit_edge ], [ %29, %._crit_edge ], !dbg !20
  %.pre-phi9 = phi i64 [ %.pre8, %..critedge_crit_edge ], [ %26, %._crit_edge ], !dbg !19
  %40 = getelementptr i32, ptr addrspace(1) %4, i64 %.pre-phi, !dbg !31
