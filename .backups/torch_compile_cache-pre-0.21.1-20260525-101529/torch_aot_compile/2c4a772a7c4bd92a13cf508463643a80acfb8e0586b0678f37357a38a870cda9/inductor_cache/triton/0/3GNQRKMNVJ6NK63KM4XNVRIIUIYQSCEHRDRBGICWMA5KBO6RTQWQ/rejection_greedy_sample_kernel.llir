  %19 = sub i32 %18, %16, !dbg !15
  %20 = icmp sgt i32 %19, 0, !dbg !16
  br i1 %20, label %.lr.ph, label %..critedge_crit_edge, !dbg !16

..critedge_crit_edge:                             ; preds = %._crit_edge3
  %.pre4 = add i32 %5, 1, !dbg !17
  %.pre6 = mul i32 %.pre4, %9, !dbg !18
  %.pre8 = sext i32 %.pre6 to i64, !dbg !19
  %.pre10 = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x(), !dbg !20
  %.pre12 = and i32 %.pre10, 127, !dbg !20
