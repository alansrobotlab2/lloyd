ninja_required_version = 1.3
name = fp4_gemm_cutlass_sm120
cuda_home = /opt/cuda
cxx = c++
nvcc = $cuda_home/bin/nvcc

common_cflags = -DPy_LIMITED_API=0x03090000 $
    -D_GLIBCXX_USE_CXX11_ABI=1 $
    -I/home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/cccl/cub $
    -I/home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/cccl/libcudacxx/include $
    -I/home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/cccl/thrust $
    -isystem /home/alansrobotlab/.local/share/uv/python/cpython-3.12.12-linux-x86_64-gnu/include/python3.12 $
    -isystem $cuda_home/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/csrc $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/cutlass/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/cutlass/tools/util/include $
    -isystem /home/alansrobotlab/lloyd/.venvs/vllm-experimental/lib/python3.12/site-packages/flashinfer/data/spdlog/include
cflags = $common_cflags $
    -fPIC $
    -std=c++17 $
    -Wno-switch-bool $
    -O3 $
    -DFAST_BUILD
post_cflags =
cuda_cflags = $common_cflags $
    --compiler-options=-fPIC $
    --expt-relaxed-constexpr $
    -static-global-template-stub=false $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -std=c++17 $
    --threads=1 $
    -use_fast_math $
    -DFLASHINFER_ENABLE_F16 $
    -DFLASHINFER_ENABLE_BF16 $
    -DFLASHINFER_ENABLE_FP8_E4M3 $
    -DFLASHINFER_ENABLE_FP8_E5M2 $
    -DNDEBUG $
    -O3 $
    -gencode=arch=compute_120f,code=sm_120f $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -DENABLE_BF16 $
    -DENABLE_FP4 $
    -DCUTLASS_ENABLE_GDC_FOR_SM100=1
cuda_post_cflags =
ldflags = -shared $
    -L$cuda_home/lib64 $
    -L$cuda_home/lib64/stubs $
    -lcudart $
    -lcuda

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $in $ldflags -o $out

