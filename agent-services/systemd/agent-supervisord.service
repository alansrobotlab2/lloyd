[Unit]
Description=Lloyd Agent Services (supervisord)
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/bash /home/alansrobotlab/lloyd/agent-services/bin/cleanup-orphans.sh
ExecStart=/home/alansrobotlab/.local/bin/supervisord -n -c /home/alansrobotlab/lloyd/agent-services/supervisor/supervisord.conf
ExecStop=/home/alansrobotlab/.local/share/uv/tools/supervisor/bin/supervisorctl -c /home/alansrobotlab/lloyd/agent-services/supervisor/supervisord.conf shutdown
ExecReload=/home/alansrobotlab/.local/share/uv/tools/supervisor/bin/supervisorctl -c /home/alansrobotlab/lloyd/agent-services/supervisor/supervisord.conf reread
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
