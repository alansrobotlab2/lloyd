[Unit]
Description=Clamp all NVIDIA GPU board power limits (Xid 79 mitigation)
Documentation=file:///home/alansrobotlab/lloyd/gpu-xid79-falloff-report.md
After=multi-user.target
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Per-GPU board power clamps (knob names: see set-gpu-power-limit.sh).
#   GPU 0, 2 — RTX 3090                    -> 275 W
#   GPU 1    — RTX PRO 6000 Blackwell      -> 400 W   (the Xid 79 card, RMA open)
# The 400 W is above the flat 300 W this unit shipped until 2026-09-11, and the
# only configuration ever described as stable on that card paired 400 W with a
# <=2400 MHz clock cap. No clock cap is set anywhere on this box — `nvidia-smi
# -i 1 --query-gpu=clocks.sm` read 2632 MHz on 2026-09-11, and 0 Xid lines were in
# the kernel journal at that time with 400 W already applied at runtime. The
# raise is deliberate with that gap open: if Xid 79/154 comes back on GPU 1,
# drop this value before suspecting anything else.
Environment=GPU_POWER_LIMIT_W=300
Environment=GPU_POWER_LIMIT_W_0=275
Environment=GPU_POWER_LIMIT_W_1=400
Environment=GPU_POWER_LIMIT_W_2=275
# Root-executed, so it deliberately runs from a root-owned system path rather
# than the repo checkout. Reinstall from ~/lloyd after editing either file:
#   install -m 0755 agent-services/bin/set-gpu-power-limit.sh /usr/local/sbin/
#   install -m 0644 agent-services/systemd/nvidia-power-limit.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl restart nvidia-power-limit.service
ExecStart=/usr/local/sbin/set-gpu-power-limit.sh

[Install]
WantedBy=multi-user.target
