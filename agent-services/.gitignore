# Wakeword / smart-turn / TTS reference assets (binary models + audio)
#
# NOTE: this pattern is UNANCHORED — it matches every `models/` dir at any
# depth, including llm/models/ (~311 GB). Do not try to negate it with `!models/`;
# that un-ignores the LLM weights too. The four custom-trained wake-word ONNX
# files are instead force-added (`git add -f`) and stay tracked thereafter:
#   models/wakeword/{Lloyd,Hey_Lloyd}.onnx
#   models/openwakeword/{melspectrogram,embedding_model}.onnx
models/
services/tts/references/

# Nested third-party repo (has its own .git; track at upstream)
services/thunderbird-mcp/

# Local backups, trash, runtime state
.backups/
.trash/
*.backup
.claude/
llama.log

/references/*

/acknowledgements/*

# TTS service venvs/models (multi-GB each, recreated by setup scripts)
services/tts/index-tts/
services/tts/qwen3-tts/
services/tts/fish-speech/
services/tts/vibevoice/

# Config with secrets (tokens) — use voice_bridge_config.example.json
voice_bridge_config.json

# Archives
*.zip

# Runtime logs directory
logs/

# Supervisor runtime logs
supervisor/*.log
supervisor/*.err

/agent-services/benchmarks
