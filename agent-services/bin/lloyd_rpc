#!/usr/bin/env python3
"""`lloyd_rpc` on the command line (P9). The client is
`agent-services/rpc/lloyd_rpc.py`, kept in a directory of its own so a script
can put it on `sys.path` without every other file in `bin/` coming along."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                os.pardir, "rpc"))
import lloyd_rpc  # noqa: E402

sys.exit(lloyd_rpc.main())
