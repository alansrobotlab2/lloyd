# ─── Toolchain caches ───────────────────────────────
.venv/
.venvs/
__pycache__/
*.pyc
/web/node_modules/

# ─── Build output ───────────────────────────────────
/web/dist/
/agent-services/benchmarks/

# ─── Runtime state ──────────────────────────────────
/logs/
/event_logs/
/sessions/
/pipeline-runs/
/autonomy-runs/
/_pipeline/

# Databases (SQLite + WAL/SHM), anywhere in tree
*.db
*.db-shm
*.db-wal

# All JSON: lockfiles, runtime state, logs — may contain personal data
*.json

# …but keep source-of-truth JSON for the web app
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/tsconfig.node.json
!web/components.json

# ─── Secrets ────────────────────────────────────────
.env

# ─── TLS / mTLS material ────────────────────────────
# Per-host CA, server cert, and per-device client certs.
# Regenerated by scripts/gen-cert.sh and scripts/mint-client-cert.sh on
# each deploy — never ship this directory. The .key and .p12 files contain
# private keys and would be a credential leak if pushed.
/agent-services/cert/

# Runtime LiveKit config rendered from livekit.yaml with secrets substituted.
/agent-services/conf/livekit.yaml.runtime

# ─── Background analysis output ─────────────────────
# Auto-generated reports & per-session analyses, may include personal data.
/analysis/

# ─── OS / misc ──────────────────────────────────────
.DS_Store
ada.zip
# Pre-upgrade snapshots of flashinfer / torch-compile caches. Regenerable build
# artifacts — 4.1 GB across 17k files. These were tracked until 2026-08-21; the
# useful part (a vllm-experimental pip freeze) now lives at
# agent-services/setup/vllm-experimental.versions.txt.
.backups/

# ─── Stray writes / scratch ─────────────────────────
# Raw yt-dlp subtitle dumps land in cwd when the transcript
# fallback runs; the product is the vault note, not the .vtt.
*.vtt

# Timestamped backup copies left by in-place edit scripts.
*.bak-*
*.bak

# Vault-bound writes that resolved against cwd (~/lloyd) instead of
# ~/obsidian. Nothing in this repo reads these paths — every consumer
# uses ~/obsidian/... — so a file appearing here is the bug, not content.
/obsidian/
/knowledge/

# Ephemeral morning-brief / triage output.
/composed_signal.txt
/scripts/composed_signal.txt
/morning-brief-*.md
