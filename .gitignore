# ─── Toolchain caches ───────────────────────────────
.venv/
.venvs/
__pycache__/
*.pyc
/web/node_modules/

# ─── Build output ───────────────────────────────────
/web/dist/
/agent-services/benchmarks/

# ─── Runtime state ──────────────────────────────────
/logs/
/event_logs/
/sessions/
/pipeline-runs/
/autonomy-runs/
/_pipeline/

# Databases (SQLite + WAL/SHM), anywhere in tree
*.db
*.db-shm
*.db-wal

# All JSON: lockfiles, runtime state, logs — may contain personal data
*.json

# …but keep source-of-truth JSON for the web app
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/tsconfig.node.json
!web/components.json

# ─── Secrets ────────────────────────────────────────
.env

# ─── OS / misc ──────────────────────────────────────
.DS_Store
ada.zip
